# =============================================================================
# RedactVision Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# The .env file is in .gitignore — NEVER commit real keys.
#
# Strict priority order (bounded fallback, NO infinite retry):
#   1. GROQ_API_KEY                      →  Groq (PRIMARY: fast, structured JSON)
#   2. OPENROUTER_API_KEY                →  OpenRouter (SECONDARY: free models only)
#   3. OMNIROUTE_URL / OMNIROUTE_API_KEY  →  OmniRoute (TERTIARY / LAST FALLBACK)
#
# Removed providers (no longer configured):
#   - Google AI Studio (Gemini): 2.5 family retired for new users
#   - NVIDIA NIM: deprecated hardcoded models
#   - Hugging Face Inference API: cold-load latency too high
# =============================================================================

# ---- Primary: Groq ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: pin a specific Groq model. Default list (in priority order)
# is defined in server/redactvision_server/providers.py:
#   1. qwen/qwen3.8-27b      (default primary)
#   2. groq/compound-mini
#   3. openai/gpt-oss-20b
# GROQ_MODEL=qwen/qwen3.8-27b

# ---- Secondary: OpenRouter (free models only) ----
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: pin a specific free model, or a comma-separated list of
# fallbacks. Default list (in priority order) is defined in providers.py:
#   1. openrouter/free                    (router — auto-routes to a working free model)
#   2. google/gemma-4-31b-it:free
#   3. minimax/minimax-m3:free
# OPENROUTER_FREE_MODELS=

# ---- Tertiary fallback: OmniRoute ----
# OmniRoute runs as a local/remote OpenAI-compatible router on port 20128
# (install via `npm i -g omniroute`, then start with `omniroute`).
OMNIROUTE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/smart

# =============================================================================
# General LLM configuration
# =============================================================================
# Per-call timeout in seconds. Each provider call will be aborted after this.
LLM_TIMEOUT_SECONDS=30
# How many times to retry a single provider on a retryable error
# (rate limit, timeout, 5xx) before moving to the next provider.
LLM_RETRIES_PER_PROVIDER=1
