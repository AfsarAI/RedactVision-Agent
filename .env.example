# =============================================================================
# RedactVision Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# The .env file is already in .gitignore — NEVER commit real keys.
#
# Priority order (multi-provider fallback loop):
#   1. GOOGLE_API_KEY  →  Google AI Studio (Gemini)
#   2. GROQ_API_KEY    →  Groq  (llama-3.3-70b-versatile → llama-3.1-8b-instant)
#   3. OPENROUTER_API_KEY  →  OpenRouter (free models: gemini-2.5-flash:free, etc.)
#   4. NVAPI_KEY / NVIDIA_API_KEY / NIM_API_KEY  →  NVIDIA NIM
#   5. OMNIROUTE_API_KEY  →  OmniRoute (pre-configured multi-provider routing)
#   6. HF_API_KEY  →  Hugging Face Inference API (mistralai/Mistral-7B-Instruct-v0.3)
# =============================================================================

# ---- Priority 1: Google AI Studio (Gemini) ----
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Priority 2: Groq ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Priority 3: OpenRouter ----
OPENROUTER_API_KEY=
# Comma-separated list of additional free models (optional)
OPENROUTER_FREE_MODELS=

# ---- Priority 4: NVIDIA NIM ----
# Accepts NVAPI_KEY, NVIDIA_API_KEY, or NIM_API_KEY
NVAPI_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ---- Priority 5: OmniRoute ----
OMNIROUTE_API_KEY=
OMNIROUTE_URL=https://api.omniroute.ai/v1/chat/completions
OMNIROUTE_MODEL=omni

# ---- Priority 6: Hugging Face Inference API ----
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# =============================================================================
# General LLM configuration (optional overrides)
# =============================================================================
LLM_BACKOFF_SECONDS=5.0        # Seconds to wait before retrying all providers
LLM_TIMEOUT_SECONDS=30.0       # Per-request timeout
LLM_MAX_ATTEMPTS=200           # Safety cap (fails with RuntimeError after this many full cycles)
