{
  "manifest_version": 3,
  "name": "RedactVision Agent",
  "version": "0.2.0",
  "description": "Privacy-preserving browser agent for SIH Problem Statement 26171.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RedactVision Agent",
    "default_popup": "dist/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/ui/chat-ui.css",
        "icons/logo.png",
        "icons/icon128.png",
        "icons/icon48.png",
        "icons/icon16.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}